# Documentation only. No .env file is required; exported variables also work.
APP_ENV=development
LOG_LEVEL=INFO
# Replace the placeholder; URL-encode credentials with reserved characters.
# Use 127.0.0.1 for a host-run backend and db inside Docker Compose.
DATABASE_URL=postgresql+psycopg://adaptive:replace_with_local_password@127.0.0.1:5432/adaptive
# Optional: same database, separate migration role outside local development.
# MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:replace_with_local_password@127.0.0.1:5432/adaptive
# TEST_DATABASE_URL is only for a disposable database whose name ends in _test.
# Destructive integration/migration tests also require ALLOW_TEST_DATABASE_RESET=1.
# Enable it only for an exclusive disposable test database, never for this app URL.

# Required: replace with a cryptographically random secret (at least 32 bytes).
# This placeholder is intentionally rejected by runtime validation.
JWT_SIGNING_KEY=replace_with_random_signing_secret
JWT_ISSUER=adaptive-assistant
JWT_AUDIENCE=adaptive-assistant-api
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_ABSOLUTE_TTL_SECONDS=604800
REFRESH_IDLE_TTL_SECONDS=86400
JWT_CLOCK_TOLERANCE_SECONDS=30
