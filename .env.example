# Local Docker Compose configuration. These are placeholders, not real secrets.
# You may export these variables in your shell instead of creating a .env file.
POSTGRES_DB=adaptive
POSTGRES_USER=adaptive
# Use a URL-safe random value (e.g. hexadecimal); replace this placeholder locally.
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Required: replace with a cryptographically random secret (at least 32 bytes).
# This placeholder is intentionally rejected by runtime validation.
JWT_SIGNING_KEY=replace_with_random_signing_secret
JWT_ISSUER=adaptive-assistant
JWT_AUDIENCE=adaptive-assistant-api
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_ABSOLUTE_TTL_SECONDS=604800
REFRESH_IDLE_TTL_SECONDS=86400
JWT_CLOCK_TOLERANCE_SECONDS=30
