{
  "name": "readbuddy-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint App.tsx index.ts jest.setup.ts src",
    "test": "jest --runInBand",
    "config:check": "expo config --type public --json",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-dev-client": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.1",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.21.5",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
