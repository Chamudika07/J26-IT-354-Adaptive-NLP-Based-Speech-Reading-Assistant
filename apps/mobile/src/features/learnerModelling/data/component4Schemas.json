{
  "LearnerProgressProjection": {
    "$defs": {
      "DashboardWindow": {
        "additionalProperties": false,
        "description": "Half-open UTC reporting period copied from the longitudinal report.",
        "properties": {
          "start_at_utc": {
            "format": "date-time",
            "title": "Start At Utc",
            "type": "string"
          },
          "end_at_utc": {
            "format": "date-time",
            "title": "End At Utc",
            "type": "string"
          }
        },
        "required": [
          "start_at_utc",
          "end_at_utc"
        ],
        "title": "DashboardWindow",
        "type": "object"
      },
      "DisplayTrend": {
        "additionalProperties": false,
        "description": "Small learner-facing observation without internal evidence details.",
        "properties": {
          "metric_name": {
            "enum": [
              "reading_accuracy",
              "reading_fluency_wpm",
              "hesitation_rate_per_word"
            ],
            "title": "Metric Name",
            "type": "string"
          },
          "display_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Display Label",
            "type": "string"
          },
          "unit": {
            "enum": [
              "proportion",
              "words_per_minute",
              "hesitations_per_attempted_word"
            ],
            "title": "Unit",
            "type": "string"
          },
          "first_value": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,28}|(?=[\\d.]{1,29}0*$)\\d*\\.\\d*0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Value"
          },
          "latest_value": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,28}|(?=[\\d.]{1,29}0*$)\\d*\\.\\d*0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Value"
          },
          "change_direction": {
            "enum": [
              "increased",
              "decreased",
              "no_observed_change",
              "insufficient_evidence"
            ],
            "title": "Change Direction",
            "type": "string"
          },
          "evidence_state": {
            "enum": [
              "sufficient",
              "limited",
              "no_observations"
            ],
            "title": "Evidence State",
            "type": "string"
          },
          "explanation": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Explanation",
            "type": "string"
          }
        },
        "required": [
          "metric_name",
          "display_label",
          "unit",
          "first_value",
          "latest_value",
          "change_direction",
          "evidence_state",
          "explanation"
        ],
        "title": "DisplayTrend",
        "type": "object"
      },
      "LearnerContextObservation": {
        "additionalProperties": false,
        "description": "Friendly labels and three approved metrics for one comparable context.",
        "properties": {
          "task_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Task Label",
            "type": "string"
          },
          "difficulty_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Difficulty Label",
            "type": "string"
          },
          "support_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Support Label",
            "type": "string"
          },
          "metrics": {
            "items": {
              "$ref": "#/$defs/DisplayTrend"
            },
            "maxItems": 3,
            "minItems": 3,
            "title": "Metrics",
            "type": "array"
          }
        },
        "required": [
          "task_label",
          "difficulty_label",
          "support_label",
          "metrics"
        ],
        "title": "LearnerContextObservation",
        "type": "object"
      },
      "LearnerDifficultyObservation": {
        "additionalProperties": false,
        "description": "Friendly, descriptive difficulty event without achievement claims.",
        "properties": {
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "task_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Task Label",
            "type": "string"
          },
          "support_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Support Label",
            "type": "string"
          },
          "difficulty_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Difficulty Label",
            "type": "string"
          },
          "description": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "observed_at",
          "task_label",
          "support_label",
          "difficulty_label",
          "description"
        ],
        "title": "LearnerDifficultyObservation",
        "type": "object"
      },
      "LearnerSupportObservation": {
        "additionalProperties": false,
        "description": "Minimized description of sessions recorded with one support mode.",
        "properties": {
          "support_label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Support Label",
            "type": "string"
          },
          "session_count": {
            "minimum": 1,
            "title": "Session Count",
            "type": "integer"
          },
          "description": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "support_label",
          "session_count",
          "description"
        ],
        "title": "LearnerSupportObservation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Minimal, supportive projection for the already-authorized learner.",
    "properties": {
      "reporting_period": {
        "$ref": "#/$defs/DashboardWindow"
      },
      "included_session_count": {
        "minimum": 0,
        "title": "Included Session Count",
        "type": "integer"
      },
      "contexts": {
        "items": {
          "$ref": "#/$defs/LearnerContextObservation"
        },
        "maxItems": 27,
        "title": "Contexts",
        "type": "array"
      },
      "support_observations": {
        "items": {
          "$ref": "#/$defs/LearnerSupportObservation"
        },
        "maxItems": 3,
        "title": "Support Observations",
        "type": "array"
      },
      "difficulty_observations": {
        "items": {
          "$ref": "#/$defs/LearnerDifficultyObservation"
        },
        "maxItems": 1024,
        "title": "Difficulty Observations",
        "type": "array"
      },
      "evidence_message": {
        "maxLength": 400,
        "minLength": 1,
        "title": "Evidence Message",
        "type": "string"
      },
      "disclaimer": {
        "maxLength": 400,
        "minLength": 1,
        "title": "Disclaimer",
        "type": "string"
      }
    },
    "required": [
      "reporting_period",
      "included_session_count",
      "contexts",
      "support_observations",
      "difficulty_observations",
      "evidence_message",
      "disclaimer"
    ],
    "title": "LearnerProgressProjection",
    "type": "object"
  },
