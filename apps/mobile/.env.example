# Development API Base URL
#
# Physical iPhone on local Wi-Fi:
# Set this to your Mac's reachable local IP address on your Wi-Fi network.
# Find your IP on Mac: run `ipconfig getifaddr en0` in Terminal.
# Backend binding: Start FastAPI with `--host 0.0.0.0 --port 8001` so it accepts LAN connections.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8001
#
# iOS simulator on Mac:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
#
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8001
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001

# Enter authorized test credentials through Configure Session at runtime.
# Never put credentials in EXPO_PUBLIC_* variables: Expo embeds them in the bundle.
